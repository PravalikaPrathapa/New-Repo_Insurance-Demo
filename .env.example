# Copy to .env and fill in. NEVER commit .env (it is git-ignored).
# Values for the first three come from the Lab Manual (sections 2-4). Replace 34.100.179.13 with YOUR assigned VM IP.

INSURANCE_BASE_URL=http://34.100.179.13:8081
# Optional: defaults to INSURANCE_BASE_URL + /api. Leave it commented out unless the API really lives elsewhere;
# a value on a different host than INSURANCE_BASE_URL is ignored with a warning.
# INSURANCE_API_BASE_URL=http://34.100.179.13:8081/api
INSURANCE_API_KEY=qa-insurance-demo-token-123
INSURANCE_PASSWORD=Password@123

# Your assigned learner account (write flows run as this user so seeded users stay untouched)
LEARNER_USER=learner001@insurance.test

# Only needed for the destructive lockout test (AUTH-V07). Use a spare learner-pool account you may lock for ~30 minutes.
# Leave empty to skip that test.
DISPOSABLE_USER=

# Browsers: comma separated list of chromium, firefox, webkit (default chromium)
BROWSERS=chromium
# Parallel workers: keep 1 on the shared lab VM
WORKERS=1

# REST API checks are OFF by default. Set to 1 only when the API is reachable from your machine.
# INSURANCE_USE_API=1
